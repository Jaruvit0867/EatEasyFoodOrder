# Environment Variables for EatEasyFoodOrder
# Copy this file to .env and fill in your values

# Database (use connection string for Azure SQL)
DATABASE_URL=sqlite:///./orders.sqlite

# Ollama LLM (optional - set to empty to disable)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=15

# CORS - Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000

# Printer (set to false to disable printing)
PRINTER_ENABLED=false
PRINTER_IP=192.168.1.200
PRINTER_PORT=9100
