# Backend environment variables for EatEasyFoodOrder
# Copy this file to backend/.env (local) or Azure App Service application settings.

# SQLite database path
# For Azure App Service custom containers, use a persistent mounted path such as /home/data/orders.sqlite
DATABASE_PATH=orders.sqlite

# Authentication (CHANGE THESE IN PRODUCTION!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here
JWT_SECRET=your-random-secret-key-here

# Ollama LLM (optional - set to empty to disable)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=15

# CORS - Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000

# Printer (set to false to disable printing)
PRINTER_ENABLED=false
PRINTER_IP=192.168.1.200
PRINTER_PORT=9100

# Frontend build-time variable lives in frontend/.env.example
